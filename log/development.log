96:                <th style="padding:8px; text-align:center;">HP</th>
97:                <th style="padding:8px; text-align:left; min-width:180px;">Items</th>
98:                <th style="padding:8px; text-align:center;">CS</th>
99:                <th style="padding:8px; text-align:center;">K</th>
100:                <th style="padding:8px; text-align:center;">D</th>
101:                <th style="padding:8px; text-align:center;">A</th>
102:                <th style="padding:8px; text-align:center;">Gold</th>
103:                <th style="padding:8px; text-align:center;">+/-</th>
104:              </tr>
105:            </thead>
106:            <tbody id="blue-team-tbody">
107:              <% (1..5).each do |i| %>
108:                <tr data-pid="<%= i %>" style="border-bottom:1px solid #f3f4f6;">
109:                  <td style="padding:8px 14px;">
110:                    <div style="display:flex; align-items:center; gap:8px;">
111:                      <img class="live-champ-img" src="" style="width:32px;height:32px;border-radius:50%;background:#e5e7eb;" onerror="this.src='https://via.placeholder.com/32'">
112:                      <div>
113:                        <div class="live-champ-name" style="font-weight:600; font-size:12px; color:#111;">—</div>
114:                        <div class="live-player-name" style="font-size:11px; color:#6b7280;">—</div>
115:                      </div>
116:                      <span class="live-level" style="margin-left:4px; font-size:10px; background:#e5e7eb; border-radius:3px; padding:1px 4px; color:#374151;">1</span>
117:                    </div>
118:                  </td>
119:                  <td style="padding:8px; min-width:80px;">
120:                    <div class="live-hp-bar" style="width:100%; height:6px; background:#e5e7eb; border-radius:3px;">
121:                      <div class="live-hp-fill" style="height:100%; width:100%; background:#22c55e; border-radius:3px;"></div>
122:                    </div>
123:                    <div class="live-hp-text" style="font-size:10px; color:#6b7280; text-align:center; margin-top:2px;">—</div>
124:                  </td>
125:                  <td style="padding:8px;">
126:                    <div class="live-items" style="display:flex; gap:2px; flex-wrap:wrap;">
127:                      <% 7.times do %><div style="width:22px;height:22px;background:#e5e7eb;border-radius:3px;"></div><% end %>
128:                    </div>
129:                  </td>
130:                  <td style="padding:8px; text-align:center; color:#374151;"><span class="live-cs">—</span></td>
131:                  <td style="padding:8px; text-align:center; color:#16a34a; font-weight:600;"><span class="live-kills">—</span></td>
132:                  <td style="padding:8px; text-align:center; color:#dc2626; font-weight:600;"><span class="live-deaths">—</span></td>
133:                  <td style="padding:8px; text-align:center; color:#2563eb; font-weight:600;"><span class="live-assists">—</span></td>
134:                  <td style="padding:8px; text-align:center; color:#374151;"><span class="live-gold">—</span></td>
135:                  <td style="padding:8px; text-align:center;"><span class="live-gold-diff" style="font-size:11px;">—</span></td>
136:                </tr>
137:              <% end %>
138:            </tbody>
139:          </table>
140:    
141:          <div style="height:2px; background:linear-gradient(to right, #1e40af, #dc2626);"></div>
142:    
143:          <!-- Red Team Table -->
144:          <table id="red-team-table" style="width:100%; border-collapse:collapse; font-size:13px;">
145:            <thead>
146:              <tr style="background:#991b1b; color:white;">
147:                <th colspan="9" style="padding:10px 14px; text-align:left; font-size:14px; font-weight:bold;">
148:                  🔴 <%= red_team&.dig("name") %>
149:                </th>
150:              </tr>
151:              <tr style="background:#f1f5f9; color:#6b7280; font-size:11px; text-transform:uppercase; border-bottom:1px solid #e5e7eb;">
152:                <th style="padding:8px 14px; text-align:left; min-width:180px;">Champion / Player</th>
153:                <th style="padding:8px; text-align:center;">HP</th>
154:                <th style="padding:8px; text-align:left; min-width:180px;">Items</th>
155:                <th style="padding:8px; text-align:center;">CS</th>
156:                <th style="padding:8px; text-align:center;">K</th>
157:                <th style="padding:8px; text-align:center;">D</th>
158:                <th style="padding:8px; text-align:center;">A</th>
159:                <th style="padding:8px; text-align:center;">Gold</th>
160:                <th style="padding:8px; text-align:center;">+/-</th>
161:              </tr>
162:            </thead>
163:            <tbody id="red-team-tbody">
164:              <% (6..10).each do |i| %>
165:                <tr data-pid="<%= i %>" style="border-bottom:1px solid #f3f4f6;">
166:                  <td style="padding:8px 14px;">
167:                    <div style="display:flex; align-items:center; gap:8px;">
168:                      <img class="live-champ-img" src="" style="width:32px;height:32px;border-radius:50%;background:#e5e7eb;" onerror="this.src='https://via.placeholder.com/32'">
169:                      <div>
170:                        <div class="live-champ-name" style="font-weight:600; font-size:12px; color:#111;">—</div>
171:                        <div class="live-player-name" style="font-size:11px; color:#6b7280;">—</div>
172:                      </div>
173:                      <span class="live-level" style="margin-left:4px; font-size:10px; background:#e5e7eb; border-radius:3px; padding:1px 4px; color:#374151;">1</span>
174:                    </div>
175:                  </td>
176:                  <td style="padding:8px; min-width:80px;">
177:                    <div class="live-hp-bar" style="width:100%; height:6px; background:#e5e7eb; border-radius:3px;">
178:                      <div class="live-hp-fill" style="height:100%; width:100%; background:#22c55e; border-radius:3px;"></div>
179:                    </div>
180:                    <div class="live-hp-text" style="font-size:10px; color:#6b7280; text-align:center; margin-top:2px;">—</div>
181:                  </td>
182:                  <td style="padding:8px;">
183:                    <div class="live-items" style="display:flex; gap:2px; flex-wrap:wrap;">
184:                      <% 7.times do %><div style="width:22px;height:22px;background:#e5e7eb;border-radius:3px;"></div><% end %>
185:                    </div>
186:                  </td>
