203:      <% game_id = game&.dig("id") %>
204:      <% all_game_ids = @games.map { |g| g["id"] }.compact %>
205:      <!-- DEBUG: game_id=<%= game_id.inspect %>, state=<%= game&.dig("state").inspect %>, all_ids=<%= all_game_ids.inspect %> -->
206:      <% if game_id.present? && game&.dig("state") != "completed" %>
207:        <script>
208:          // Wrap in IIFE to avoid Turbo re-declaration errors
209:          (function() {
210:            if (window._livePolling) { clearInterval(window._livePolling); }
211:    
212:            const GAME_ID = "<%= game_id %>";
213:    
214:            const PATCH_VERSION = "16.10.1"; // updated from gameMetadata on first load
215:            let metadata = null; // gameMetadata from window API
216:    
217:            function getRow(participantId) {
218:              return document.querySelector(`[data-pid="${participantId}"]`);
219:            }
220:    
221:            function updatePlayerRow(row, player, detailsParticipant, teamGold, opposingGold) {
222:              if (!row) return;
223:    
224:              // Champion image + name + summoner name (from metadata)
225:              if (metadata) {
226:                const isBlue = player.participantId <= 5;
227:                const teamMeta = isBlue ? metadata.blueTeamMetadata : metadata.redTeamMetadata;
228:                const idx = isBlue ? player.participantId - 1 : player.participantId - 6;
229:                const p = teamMeta?.participantMetadata?.[idx];
230:                if (p) {
231:                  const img = row.querySelector('.live-champ-img');
232:                  if (img) img.src = `https://ddragon.leagueoflegends.com/cdn/${PATCH_VERSION}/img/champion/${p.championId}.png`;
233:                  const champEl = row.querySelector('.live-champ-name');
234:                  if (champEl) champEl.textContent = p.championId;
235:                  const nameEl = row.querySelector('.live-player-name');
236:                  if (nameEl) nameEl.textContent = p.summonerName;
237:                }
238:              }
239:    
240:              // Level
241:              const lvlEl = row.querySelector('.live-level');
242:              if (lvlEl) lvlEl.textContent = player.level ?? 1;
243:    
244:              // HP bar
245:              const hpFill = row.querySelector('.live-hp-fill');
246:              const hpText = row.querySelector('.live-hp-text');
247:              if (hpFill && player.maxHealth > 0) {
248:                const pct = Math.max(0, Math.min(100, (player.currentHealth / player.maxHealth) * 100));
249:                hpFill.style.width = pct + '%';
250:                hpFill.style.background = pct > 50 ? '#22c55e' : pct > 25 ? '#f59e0b' : '#ef4444';
251:              }
252:              if (hpText) hpText.textContent = `${player.currentHealth ?? 0}/${player.maxHealth ?? 0}`;
253:    
254:              // Stats
255:              const cs = row.querySelector('.live-cs');
256:              const kills = row.querySelector('.live-kills');
257:              const deaths = row.querySelector('.live-deaths');
258:              const assists = row.querySelector('.live-assists');
259:              const gold = row.querySelector('.live-gold');
260:              if (cs) cs.textContent = player.creepScore ?? 0;
261:              if (kills) kills.textContent = player.kills ?? 0;
262:              if (deaths) deaths.textContent = player.deaths ?? 0;
263:              if (assists) assists.textContent = player.assists ?? 0;
264:              if (gold) gold.textContent = player.totalGold ? Number(player.totalGold).toLocaleString() : '—';
265:    
266:              // Gold diff
267:              const goldDiff = row.querySelector('.live-gold-diff');
268:              if (goldDiff && player.totalGold != null && opposingGold != null) {
269:                const diff = player.totalGold - opposingGold;
270:                goldDiff.textContent = diff >= 0 ? `+${diff.toLocaleString()}` : diff.toLocaleString();
271:                goldDiff.style.color = diff >= 0 ? '#16a34a' : '#dc2626';
272:              }
273:    
274:              // Items (from details)
275:              if (detailsParticipant?.items) {
276:                const itemsEl = row.querySelector('.live-items');
277:                if (itemsEl) {
278:                  itemsEl.innerHTML = detailsParticipant.items.map(itemId =>
279:                    itemId > 0
280:                      ? `<img src="https://ddragon.leagueoflegends.com/cdn/${PATCH_VERSION}/img/item/${itemId}.png" style="width:22px;height:22px;border-radius:3px;" onerror="this.style.display='none'">`
281:                      : `<div style="width:22px;height:22px;background:#e5e7eb;border-radius:3px;"></div>`
282:                  ).join('');
283:                }
284:              }
285:            }
286:    
287:            function updateScoreboard(data) {
288:              if (!data || !data.frames || data.frames.length === 0) return;
289:              const frame = data.frames[data.frames.length - 1];
290:    
291:              // Store metadata on first load
292:              if (data.gameMetadata) {
293:                metadata = data.gameMetadata;
294:                // Update patch version from metadata
295:                if (data.gameMetadata.patchVersion) {
296:                  const parts = data.gameMetadata.patchVersion.split('.');
297:                  // patchVersion looks like "16.10.776.5552" → we want "16.10.1"
298:                  if (parts.length >= 2) window._lolPatch = `${parts[0]}.${parts[1]}.1`;
299:                }
300:              }
301:    
302:              // Header: game time
303:              const timeEl = document.getElementById('live-game-time');
304:              if (timeEl && frame.gameTime != null) {
305:                const mins = Math.floor(frame.gameTime / 60000);
306:                const secs = Math.floor((frame.gameTime % 60000) / 1000);
307:                timeEl.textContent = `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
308:              }
309:    
310:              // Header: towers/barons
311:              const blue = frame.blueTeam;
312:              const red = frame.redTeam;
313:              if (blue && red) {
314:                const towerEl = document.getElementById('live-towers');
315:                if (towerEl) towerEl.textContent = `${blue.towers ?? '—'} – ${red.towers ?? '—'}`;
316:                const baronEl = document.getElementById('live-barons');
317:                if (baronEl) baronEl.textContent = `${blue.barons ?? '—'} – ${red.barons ?? '—'}`;
318:    
319:                // Per-player rows (window data)
320:                const blueParticipants = blue.participants || [];
321:                const redParticipants = red.participants || [];
322:    
323:                blueParticipants.forEach((p, i) => {
324:                  const opposing = redParticipants[i];
325:                  const row = getRow(p.participantId);
326:                  updatePlayerRow(row, p, null, p.totalGold, opposing?.totalGold);
327:                });
328:                redParticipants.forEach((p, i) => {
329:                  const opposing = blueParticipants[i];
330:                  const row = getRow(p.participantId);
331:                  updatePlayerRow(row, p, null, p.totalGold, opposing?.totalGold);
332:                });
333:              }
334:            }
335:    
336:            function updateDetails(data) {
337:              if (!data || !data.frames || data.frames.length === 0) return;
338:              const frame = data.frames[data.frames.length - 1];
339:              const all = [...(frame.blueTeam?.participants || []), ...(frame.redTeam?.participants || [])];
340:              all.forEach((dp, i) => {
341:                const pid = i + 1;
342:                const row = getRow(pid);
343:                if (row) {
344:                  const itemsEl = row.querySelector('.live-items');
345:                  if (itemsEl && dp.items) {
346:                    const patch = window._lolPatch || PATCH_VERSION;
347:                    itemsEl.innerHTML = dp.items.map(itemId =>
348:                      itemId > 0
349:                        ? `<img src="https://ddragon.leagueoflegends.com/cdn/${patch}/img/item/${itemId}.png" style="width:22px;height:22px;border-radius:3px;" onerror="this.style.display='none'">`
350:                        : `<div style="width:22px;height:22px;background:#e5e7eb;border-radius:3px;"></div>`
351:                    ).join('');
352:                  }
353:                }
354:              });
355:            }
356:    
357:            function getLiveTimestamp() {
358:              const date = new Date();
359:              date.setMilliseconds(0);
360:              date.setSeconds(date.getSeconds() - (date.getSeconds() % 10)); // round down to nearest 10s
361:              date.setSeconds(date.getSeconds() - 140); // API requires window to be at least 130s old
362:              return date.toISOString();
363:            }
364:    
365:            async function poll() {
366:              try {
367:                const ts = encodeURIComponent(getLiveTimestamp());
368:                const [windowRes, detailsRes] = await Promise.all([
369:                  fetch(`/api/live/window/${GAME_ID}?startingTime=${ts}`),
370:                  fetch(`/api/live/details/${GAME_ID}?startingTime=${ts}`)
371:                ]);
372:    
373:                if (windowRes.ok) {
374:                  const data = await windowRes.json();
375:                  if (data.frames && data.frames.length > 0) {
376:                    updateScoreboard(data);
377:                  }
378:                }
379:    
380:                if (detailsRes.ok) {
381:                  const data = await detailsRes.json();
382:                  if (data.frames && data.frames.length > 0) {
383:                    updateDetails(data);
384:                  }
385:                }
386:              } catch(e) {
387:                console.warn('Poll error:', e);
388:              }
389:            }
390:    
391:            poll();
392:            window._livePolling = setInterval(poll, 500);
393:          })();
394:        </script>
395:      <% end %>
396:    <% end %>
  
