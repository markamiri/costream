207:        <script>
208:          // Wrap in IIFE to avoid Turbo re-declaration errors
209:          (function() {
210:            if (window._livePolling) { clearInterval(window._livePolling); }
211:    
212:            const GAME_ID = "<%= game_id %>";
213:    
214:            function updateScoreboard(data) {
215:              if (!data || !data.frames || data.frames.length === 0) return;
216:              const frame = data.frames[data.frames.length - 1];
217:    
218:              const timeEl = document.getElementById('live-game-time');
219:              if (timeEl && frame.gameTime != null) {
220:                const mins = Math.floor(frame.gameTime / 60000);
221:                const secs = Math.floor((frame.gameTime % 60000) / 1000);
222:                timeEl.textContent = `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
223:              }
224:    
225:              const blueFrame = frame.blueTeam;
226:              const redFrame = frame.redTeam;
227:              if (blueFrame && redFrame) {
228:                const towerEl = document.getElementById('live-towers');
229:                if (towerEl) towerEl.textContent = `${blueFrame.towers ?? '—'} – ${redFrame.towers ?? '—'}`;
230:                const baronEl = document.getElementById('live-barons');
231:                if (baronEl) baronEl.textContent = `${blueFrame.barons ?? '—'} – ${redFrame.barons ?? '—'}`;
232:              }
233:            }
234:    
235:            function updateDetails(data) {
236:              if (!data || !data.frames || data.frames.length === 0) return;
237:              const frame = data.frames[data.frames.length - 1];
238:    
239:              const allParticipants = [
240:                ...(frame.blueTeam?.participants || []),
241:                ...(frame.redTeam?.participants || [])
242:              ];
243:    
244:              allParticipants.forEach(p => {
245:                const row = document.querySelector(`[data-puuid="${p.participantId}"]`);
246:                if (!row) return;
247:                const kdaEl = row.querySelector('.live-kda');
248:                const csEl = row.querySelector('.live-cs');
249:                const goldEl = row.querySelector('.live-gold');
250:                if (kdaEl) kdaEl.textContent = `${p.kills ?? 0}/${p.deaths ?? 0}/${p.assists ?? 0}`;
251:                if (csEl) csEl.textContent = p.creepScore ?? '—';
252:                if (goldEl) goldEl.textContent = p.totalGold ? `${(p.totalGold / 1000).toFixed(1)}k` : '—';
253:              });
254:            }
255:    
256:            function getLiveTimestamp() {
257:              const date = new Date();
258:              date.setMilliseconds(0);
259:              date.setSeconds(date.getSeconds() - (date.getSeconds() % 10)); // round down to nearest 10s
260:              date.setSeconds(date.getSeconds() - 140); // API requires window to be at least 130s old
261:              return date.toISOString();
262:            }
263:    
264:            async function poll() {
265:              try {
266:                const ts = encodeURIComponent(getLiveTimestamp());
267:                const [windowRes, detailsRes] = await Promise.all([
268:                  fetch(`/api/live/window/${GAME_ID}?startingTime=${ts}`),
269:                  fetch(`/api/live/details/${GAME_ID}?startingTime=${ts}`)
270:                ]);
271:    
272:                if (windowRes.ok) {
273:                  const data = await windowRes.json();
274:                  if (data.frames && data.frames.length > 0) {
275:                    updateScoreboard(data);
276:                  }
277:                }
278:    
279:                if (detailsRes.ok) {
280:                  const data = await detailsRes.json();
281:                  if (data.frames && data.frames.length > 0) {
282:                    updateDetails(data);
283:                  }
284:                }
285:              } catch(e) {
286:                console.warn('Poll error:', e);
287:              }
288:            }
289:    
290:            poll();
291:            window._livePolling = setInterval(poll, 500);
292:          })();
293:        </script>
294:      <% end %>
295:    <% end %>
  
