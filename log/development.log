188:                  <td style="padding:8px; text-align:center; color:#16a34a; font-weight:600;"><span class="live-kills">—</span></td>
189:                  <td style="padding:8px; text-align:center; color:#dc2626; font-weight:600;"><span class="live-deaths">—</span></td>
190:                  <td style="padding:8px; text-align:center; color:#2563eb; font-weight:600;"><span class="live-assists">—</span></td>
191:                  <td style="padding:8px; text-align:center; color:#374151;"><span class="live-gold">—</span></td>
192:                  <td style="padding:8px; text-align:center;"><span class="live-gold-diff" style="font-size:11px;">—</span></td>
