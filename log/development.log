26:        <div style="display:flex; align-items:center; justify-content:space-between; max-width: 900px; margin: 0 auto;">
27:    
28:          <!-- Blue Team -->
29:          <div style="display:flex; align-items:center; gap:12px;">
30:            <img src="<%= blue_team&.dig("image") %>" alt="<%= blue_team&.dig("name") %>"
31:                 style="width:56px; height:56px; object-fit:contain; border-bottom: 4px solid #3b82f6; background:#f3f4f6; padding:4px;"
32:                 onerror="this.src='https://via.placeholder.com/56'">
33:            <div>
34:              <div style="font-weight:bold; font-size:18px;"><%= blue_team&.dig("name") %></div>
35:              <div style="font-size:13px; color:#6b7280;">Game wins: <%= blue_team&.dig("result", "gameWins") || 0 %></div>
36:            </div>
37:          </div>
38:    
39:          <!-- Center Stats -->
40:          <div style="display:flex; align-items:center; gap:24px; color:#6b7280;">
41:            <div style="text-align:center;">
42:              <div style="font-size:11px; text-transform:uppercase;">Towers</div>
43:              <div id="live-towers" style="font-weight:bold; font-size:18px; color:#111;">
44:                <%= game&.dig("teams", 0, "objectives", "tower", "kills") || "—" %>
45:                &nbsp;–&nbsp;
46:                <%= game&.dig("teams", 1, "objectives", "tower", "kills") || "—" %>
47:              </div>
48:            </div>
49:            <div style="text-align:center;">
50:              <div style="font-size:11px; text-transform:uppercase;"><%= game&.dig("state") == "completed" ? "Final" : "Live" %></div>
51:              <div style="font-weight:bold; font-size:18px; color:#111;">
52:                <%= blue_team&.dig("result", "gameWins") || 0 %> – <%= red_team&.dig("result", "gameWins") || 0 %>
53:              </div>
54:              <% if game&.dig("state") != "completed" %>
55:                <div id="live-game-time" style="font-size:12px; color:#ef4444; font-weight:bold;">⬤ LIVE</div>
56:              <% end %>
57:            </div>
58:            <div style="text-align:center;">
59:              <div style="font-size:11px; text-transform:uppercase;">Barons</div>
60:              <div id="live-barons" style="font-weight:bold; font-size:18px; color:#111;">
61:                <%= game&.dig("teams", 0, "objectives", "baron", "kills") || "—" %>
62:                &nbsp;–&nbsp;
63:                <%= game&.dig("teams", 1, "objectives", "baron", "kills") || "—" %>
64:              </div>
65:            </div>
66:          </div>
67:    
68:          <!-- Red Team -->
69:          <div style="display:flex; align-items:center; gap:12px; text-align:right; flex-direction:row-reverse;">
70:            <img src="<%= red_team&.dig("image") %>" alt="<%= red_team&.dig("name") %>"
71:                 style="width:56px; height:56px; object-fit:contain; border-bottom: 4px solid #ef4444; background:#f3f4f6; padding:4px;"
72:                 onerror="this.src='https://via.placeholder.com/56'">
73:            <div>
74:              <div style="font-weight:bold; font-size:18px;"><%= red_team&.dig("name") %></div>
75:              <div style="font-size:13px; color:#6b7280;">Game wins: <%= red_team&.dig("result", "gameWins") || 0 %></div>
76:            </div>
77:          </div>
78:    
79:        </div>
80:      </div>
